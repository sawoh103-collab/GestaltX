    "Usually, changing the region code is enough. There is no need to change Sales Region.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually, changing the region code is enough. There is no need to change Sales Region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常只需修改地区代码，无需更改销售地区。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por lo general, cambiar el código de región es suficiente. No es necesario cambiar la región de venta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معمولاً تغییر کد منطقه کافی است. نیازی به تغییر منطقهٔ فروش نیست."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적으로 지역 코드만 변경해도 충분합니다. 판매 지역까지 변경할 필요는 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно достаточно изменить код региона. Менять регион продажи не нужно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông thường, chỉ cần thay đổi mã vùng. Không cần đổi khu vực bán hàng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "通常只需修改地區代碼，毋須更改銷售地區。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "通常只需修改地區代碼，無需變更銷售地區。"
          }
        }
      }
    },
    "* If you previously changed Sales Region, restore your device's original sales region and apply it first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* If you previously changed Sales Region, restore your device's original sales region and apply it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "* 之前修改过销售地区的用户，请先改回设备原本的销售地区并应用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "* Si cambiaste previamente la región de venta, restaura la región original de tu dispositivo y aplícala primero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "* اگر قبلاً منطقهٔ فروش را تغییر داده‌اید، ابتدا منطقهٔ فروش اصلی دستگاه را بازگردانید و تغییر را اعمال کنید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "* 과거에 판매 지역 설정을 변경한 적이 있다면, 기능을 적용하기 전에 기기의 원래 판매 지역으로 복원하는 과정을 먼저 거치십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "* Если вы ранее меняли регион продажи, сначала верните исходный регион продажи устройства и примените изменения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "* Nếu trước đây bạn đã đổi khu vực bán hàng, hãy khôi phục khu vực bán hàng ban đầu của thiết bị và áp dụng trước."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "* 之前修改過銷售地區的用戶，請先改回裝置原本的銷售地區並套用。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "* 先前修改過銷售地區的使用者，請先改回裝置原本的銷售地區並套用。"
          }
        }
      }
    },
    "Changing the sales-region suffix may cause verification tools to report a mismatch with factory information.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the sales-region suffix may cause verification tools to report a mismatch with factory information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改销售地区后缀可能导致验机工具提示与出厂信息不匹配。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el sufijo de la región de venta puede provocar que las herramientas de verificación indiquen discrepancias con la información de fábrica."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر پسوند منطقهٔ فروش ممکن است باعث شود ابزارهای بررسی، عدم تطابق با اطلاعات کارخانه را گزارش کنند."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판매 지역 접미사를 변경하면 기기 검증 도구에서 공장 출고 정보와 일치하지 않는다는 경고가 표시될 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение суффикса региона продажи может вызвать предупреждение о несовпадении с заводскими данными в программах проверки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi hậu tố khu vực bán hàng có thể khiến công cụ kiểm tra báo không khớp với thông tin xuất xưởng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更改銷售地區後綴可能導致驗機工具提示與出廠資料不符。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "變更銷售地區尾碼可能導致驗機工具提示與出廠資訊不符。"
          }
        }
      }
    },
    "Changing a region flag does not guarantee Apple Intelligence or region-restricted services.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing a region flag does not guarantee Apple Intelligence or region-restricted services."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地区标记并不保证可用 Apple 智能或受地区限制的服务。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar un ajuste de región no garantiza el acceso a Apple Intelligence ni a servicios con restricción geográfica."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییر پرچم منطقه، فعال شدن Apple Intelligence یا خدمات محدودشده به منطقه را تضمین نمی‌کند."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역 플래그를 변경하더라도 Apple Intelligence 또는 지역 제한 서비스 활성화가 보장되지는 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение флага региона не гарантирует работу Apple Intelligence или сервисов с региональными ограничениями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi cờ vùng không bảo đảm Apple Intelligence hoặc các dịch vụ bị giới hạn theo vùng sẽ hoạt động."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地區標記並不保證可用 Apple 智能或受地區限制的服務。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地區標記並不保證可用 Apple 智慧或受地區限制的服務。"
          }
        }
      }
    },
