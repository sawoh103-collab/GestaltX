    "Restart the device manually after applying device changes. GestaltX does not restart SpringBoard.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the device manually after applying device changes. GestaltX does not restart SpringBoard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用本机更改后，请手动重启设备。GestaltX 不会重新启动 SpringBoard。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia el dispositivo manualmente después de aplicar cambios al dispositivo. GestaltX no reinicia SpringBoard."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از اعمال تغییرات دستگاه، آن را به‌صورت دستی دوباره راه‌اندازی کنید. GestaltX، SpringBoard را دوباره راه‌اندازی نمی‌کند."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 변경 사항을 적용한 후 기기를 수동으로 재시동하십시오. GestaltX는 SpringBoard를 재시작하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После применения изменений перезагрузите устройство вручную. GestaltX не перезапускает SpringBoard."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại thiết bị theo cách thủ công sau khi áp dụng thay đổi trên thiết bị. GestaltX không khởi động lại SpringBoard."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "應用本機更改後，請手動重新啓動設備。GestaltX 不會重新啓動 SpringBoard。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "套用裝置變更後，請手動重新啟動裝置。GestaltX 不會重新啟動 SpringBoard。"
          }
        }
      }
    },
