    "A device restart may be required after changing the model number.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restart may be required after changing the model number."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改型号号码后可能需要重启设备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede ser necesario reiniciar el dispositivo después de cambiar el número de modelo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از تغییر شمارهٔ مدل ممکن است لازم باشد دستگاه را راه‌اندازی مجدد کنید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 번호를 변경한 후 시스템에 완전히 반영되려면 기기를 재시동해야 할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После изменения номера модели может потребоваться перезагрузка устройства."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể cần khởi động lại thiết bị sau khi đổi số kiểu máy."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "修改型號號碼後可能需要重新啟動裝置。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "修改型號號碼後可能需要重新啟動裝置。"
          }
        }
      }
    },
    "Listed values apply to iPhone Air, iPhone 18 Pro and iPhone 18 Pro Max only. Choosing a model number that does not match your hardware can make verification tools report a mismatch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listed values apply to iPhone Air, iPhone 18 Pro and iPhone 18 Pro Max only. Choosing a model number that does not match your hardware can make verification tools report a mismatch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下号码仅适用于 iPhone Air、iPhone 18 Pro 和 iPhone 18 Pro Max。选择与硬件不符的号码，可能导致验机工具报告不匹配。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores indicados solo se aplican al iPhone Air, iPhone 18 Pro y iPhone 18 Pro Max. Elegir un número de modelo que no coincida con tu hardware puede hacer que las herramientas de verificación detecten una discrepancia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این شماره‌ها فقط برای iPhone Air، iPhone 18 Pro و iPhone 18 Pro Max هستند. انتخاب شماره‌ای ناسازگار با سخت‌افزار ممکن است باعث گزارش عدم تطابق در ابزارهای بررسی شود."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 번호는 iPhone Air, iPhone 18 Pro 및 iPhone 18 Pro Max에만 해당합니다. 하드웨어와 다른 번호를 선택하면 기기 검사 도구에서 불일치가 보고될 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти номера предназначены только для iPhone Air, iPhone 18 Pro и iPhone 18 Pro Max. Номер, не соответствующий оборудованию, может вызвать предупреждение в программах проверки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các số này chỉ dành cho iPhone Air, iPhone 18 Pro và iPhone 18 Pro Max. Chọn số không khớp phần cứng có thể khiến công cụ kiểm tra báo không khớp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "以下號碼僅適用於 iPhone Air、iPhone 18 Pro 和 iPhone 18 Pro Max。選擇與硬件不符的號碼，可能導致驗機工具顯示不符。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "以下號碼僅適用於 iPhone Air、iPhone 18 Pro 和 iPhone 18 Pro Max。選擇與硬體不符的號碼，可能導致驗機工具回報不符。"
          }
        }
      }
    },
