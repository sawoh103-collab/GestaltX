    "Enable AOD flipbook widgets on the Lock Screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable AOD flipbook widgets on the Lock Screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁屏上启用 AOD 翻页小组件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar widgets tipo flipbook de pantalla siempre activa en la pantalla bloqueada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویجت‌های فلیپ‌بوک AOD را در صفحه قفل فعال می‌کند."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에 상시표시형 디스플레이 플립북 위젯 기능이 렌더링되도록 활성화합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает виджеты flipbook AOD на экране блокировки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật tiện ích flipbook AOD trên màn hình khóa."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
