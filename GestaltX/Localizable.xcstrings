    "Device access is unavailable in the Simulator. Open a plist to explore GestaltX.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device access is unavailable in the Simulator. Open a plist to explore GestaltX."
          }
        },
        "zh-Hans": {
          "stringUnit": {
