    "Set how many AOD flipbook entries are allowed. Experimental; the accepted range varies by build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set how many AOD flipbook entries are allowed. Experimental; the accepted range varies by build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置允许的 AOD 翻页条目数量。实验性功能，可用范围因系统版本而异。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece cuántas entradas de flipbook AOD están permitidas. Experimental; el rango admitido varía según la compilación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد ورودی‌های مجاز فلیپ‌بوک AOD را تنظیم می‌کند. آزمایشی؛ محدوده مجاز بسته به build متفاوت است."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용되는 상시표시형 디스플레이 플립북 항목의 최대 개수를 설정합니다. 실험적인 기능이며, 안정적으로 작동하는 허용 범위는 시스템 빌드에 따라 달라집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаёт число записей flipbook AOD. Экспериментально; допустимый диапазон зависит от сборки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt số mục flipbook AOD được phép. Thử nghiệm; phạm vi hợp lệ tùy bản dựng."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設定允許的 AOD 翻頁項目數量。實驗性功能，可用範圍因系統版本而異。"
          }
