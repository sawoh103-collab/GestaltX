    "Available paths and MobileGestalt presets vary by device and OS build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available paths and MobileGestalt presets vary by device and OS build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可访问的路径及 MobileGestalt 预设因设备与系统版本而异。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rutas y preajustes de MobileGestalt disponibles varían según el dispositivo y la versión del SO."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسیرهای قابل دسترسی و پیش‌تنظیم‌های MobileGestalt بسته به دستگاه و نسخهٔ سیستم‌عامل متفاوت‌اند."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정 가능한 시스템 경로 및 사용 가능한 MobileGestalt 프리셋 목록은 기기 종류와 OS 빌드 버전에 따라 다르게 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступные пути и предустановки MobileGestalt зависят от устройства и сборки ОС."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đường dẫn có thể truy cập và thiết lập sẵn MobileGestalt khác nhau tùy theo thiết bị và bản hệ điều hành."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可存取的路徑及 MobileGestalt 預設因裝置與系統版本而異。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "可存取的路徑及 MobileGestalt 預設因裝置與系統版本而異。"
          }
        }
      }
    },
