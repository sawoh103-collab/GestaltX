        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX never restarts SpringBoard. After device changes, restart the iPhone or iPad manually before checking the result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX 不会重新启动 SpringBoard。修改本机后，请手动重启 iPhone 或 iPad，再检查结果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX nunca reinicia SpringBoard. Después de cambiar el dispositivo, reinicia manualmente el iPhone o iPad antes de comprobar el resultado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX هرگز SpringBoard را دوباره راه‌اندازی نمی‌کند. پس از تغییرات دستگاه، پیش از بررسی نتیجه iPhone یا iPad را به‌صورت دستی دوباره راه‌اندازی کنید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX는 SpringBoard를 재시작하지 않습니다. 기기를 변경한 후 결과를 확인하기 전에 iPhone 또는 iPad를 수동으로 재시동하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX никогда не перезапускает SpringBoard. После изменений перезагрузите iPhone или iPad вручную, прежде чем проверять результат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX không bao giờ khởi động lại SpringBoard. Sau khi thay đổi thiết bị, hãy khởi động lại iPhone hoặc iPad theo cách thủ công trước khi kiểm tra kết quả."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX 不會重新啓動 SpringBoard。修改本機後，請手動重新啓動 iPhone 或 iPad，再檢查結果。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "GestaltX 不會重新啟動 SpringBoard。修改裝置後，請手動重新啟動 iPhone 或 iPad，再檢查結果。"
          }
        }
      }
    },
    "License text could not be loaded.": {
