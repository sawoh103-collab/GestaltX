    "MobileGestalt access was denied. Check the OS version and App Group signing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt access was denied. Check the OS version and App Group signing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 访问被拒绝，请检查系统版本与 App Group 签名。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso a MobileGestalt denegado. Comprueba la versión del SO y la firma de App Group."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به MobileGestalt رد شد. نسخهٔ سیستم‌عامل و امضای App Group را بررسی کنید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 파일 접근이 거부되었습니다. 사용 중인 OS 버전 및 App Group 서명 상태를 확인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к MobileGestalt запрещён. Проверьте версию ОС и подпись App Group."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập MobileGestalt bị từ chối. Kiểm tra phiên bản hệ điều hành và chữ ký App Group."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 訪問被拒絕，請檢查系統版本與 App Group 簽名。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 訪問被拒絕，請檢查系統版本與 App Group 簽名。"
          }
        }
      }
    },
    "The backup could not be verified. No system write was started.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup could not be verified. No system write was started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份验证失败，未开始写入系统文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el respaldo. No se inició la escritura en el sistema."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخهٔ پشتیبان تأیید نشد. نوشتن روی سیستم آغاز نشده است."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 파일의 무결성을 검증할 수 없어 시스템 쓰기 작업이 시작되지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить резервную копию. Запись в систему не начиналась."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh bản sao lưu. Chưa bắt đầu ghi vào hệ thống."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "備份驗證失敗，未開始寫入系統文件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "備份驗證失敗，未開始寫入系統檔案。"
          }
        }
      }
    },
    "This backup does not belong to this device. Open it as a local file instead.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup does not belong to this device. Open it as a local file instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份不属于当前设备，请将其作为本地文件打开。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este respaldo no pertenece a este dispositivo. Ábrelo como archivo local."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخهٔ پشتیبان متعلق به این دستگاه نیست. آن را به‌عنوان فایل محلی باز کنید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 현재 연결된 기기의 파일이 아닙니다. 이 기기에 복원하는 대신 로컬 파일로 열어 내용을 확인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия принадлежит другому устройству. Откройте её как локальный файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu này không thuộc thiết bị hiện tại. Hãy mở dưới dạng tệp cục bộ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份不屬於當前設備，請將其作為本地文件打開。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份不屬於當前裝置，請將其作為本地檔案開啟。"
          }
        }
      }
    },
    "MobileGestalt changed since it was loaded. Refresh before applying your edits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt changed since it was loaded. Refresh before applying your edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 已在加载后发生变化，请刷新后再应用更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt cambió desde que fue cargado. Actualiza antes de aplicar tus cambios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt پس از خوانده‌شدن تغییر کرده است. پیش از اعمال ویرایش‌ها دوباره آن را بخوانید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최초 로드 시점 이후 백그라운드에서 MobileGestalt 내용이 변경되었습니다. 변경 사항을 적용하기 전에 최신 데이터를 다시 읽어 오십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt изменился после чтения. Обновите данные перед применением изменений."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt đã thay đổi sau khi được đọc. Làm mới trước khi áp dụng chỉnh sửa."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 已在加載後發生變化，請刷新後再應用更改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "MobileGestalt 已在載入後發生變化，請重新整理後再應用更改。"
          }
        }
      }
    },
    "The write did not match the readback.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The write did not match the readback."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入内容与回读结果不一致。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura no coincidió con la relectura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های نوشته‌شده با نتیجهٔ بازخوانی یکسان نیستند."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 데이터와 다시 읽어온 값이 일치하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записанные данные не совпадают с прочитанными."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung ghi không khớp với dữ liệu đọc lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入內容與回讀結果不一致。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入內容與回讀結果不一致。"
          }
        }
      }
    },
    "The original file could not be restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file could not be restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复原始文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restaurar el archivo original."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بازیابی فایل اصلی ممکن نشد."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 오류로 인해 원본 파일을 복원할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось восстановить исходный файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khôi phục tệp gốc."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法恢復原始文件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "無法恢復原始檔案。"
          }
        }
      }
    },
    "Write verification and recovery failed. Keep the backup and recover the device file before trying again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write verification and recovery failed. Keep the backup and recover the device file before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入验证与恢复均失败。请保留备份，恢复设备文件后再尝试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación de escritura y la recuperación fallaron. Conserva el respaldo y recupera el archivo del dispositivo antes de volver a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تأیید نوشتن و بازیابی هر دو ناموفق بودند. نسخهٔ پشتیبان را نگه دارید و پیش از تلاش دوباره، فایل دستگاه را بازیابی کنید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 검증 및 원상 복구 시도가 모두 실패했습니다. 작업 중이던 백업을 안전하게 보관하고, 기기 시스템 파일을 정상 상태로 복구한 뒤 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка записи и восстановление завершились ошибкой. Сохраните резервную копию и восстановите файл устройства перед новой попыткой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh nội dung ghi và khôi phục đều thất bại. Giữ bản sao lưu và khôi phục tệp thiết bị trước khi thử lại."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入驗證與恢復均失敗。請保留備份，恢復設備文件後再嘗試。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入驗證與恢復均失敗。請保留備份，恢復裝置檔案後再嘗試。"
          }
        }
      }
    },
    "The write failed. The previous file was restored and verified.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The write failed. The previous file was restored and verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入失败，之前的文件已恢复并通过验证。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la escritura. El archivo anterior fue restaurado y verificado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوشتن ناموفق بود. فایل قبلی بازیابی و تأیید شد."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 작업에 실패했습니다. 이전 파일이 복원되고 검증되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись не удалась. Предыдущий файл восстановлен и проверен."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi thất bại. Tệp trước đó đã được khôi phục và xác minh."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入失敗，之前的文件已恢復並通過驗證。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
