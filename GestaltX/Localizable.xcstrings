    "Open the system cache, or work with a plist from Files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the system cache, or work with a plist from Files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取系统缓存，或编辑“文件”中的 plist。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la caché del sistema o trabaja con un plist desde Archivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظهٔ نهان سیستم را باز کنید یا با یک plist از برنامهٔ Files کار کنید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 캐시를 열거나 파일 앱의 plist로 작업하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте системный кэш или работайте с plist из приложения «Файлы»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bộ nhớ đệm hệ thống hoặc chỉnh sửa tệp plist từ ứng dụng Tệp."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取系統緩存，或編輯“文件”中的 plist。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取系統快取，或編輯“檔案”中的 plist。"
          }
        }
      }
    },
