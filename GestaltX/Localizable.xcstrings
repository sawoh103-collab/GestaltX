    "Use an XML plist fragment, including the array or dict tags. Nested data and numeric types are preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an XML plist fragment, including the array or dict tags. Nested data and numeric types are preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入包含 array 或 dict 标签的 XML plist 片段。嵌套的数据与数字类型会被保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un fragmento XML de plist, incluyendo las etiquetas array o dict. Se conservan los datos anidados y los tipos numéricos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از یک قطعهٔ XML plist شامل برچسب‌های array یا dict استفاده کنید. داده‌های تودرتو و نوع عددها حفظ می‌شوند."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "array 또는 dict 태그를 포함한 XML plist 조각을 사용하십시오. 중첩된 데이터 및 숫자 타입이 그대로 보존됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте фрагмент XML plist с тегами array или dict. Вложенные данные и числовые типы сохраняются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập một đoạn XML plist có thẻ array hoặc dict. Dữ liệu lồng nhau và các kiểu số được giữ nguyên."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入包含 array 或 dict 標籤的 XML plist 片段。嵌套的數據與數字類型會被保留。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入包含 array 或 dict 標籤的 XML plist 片段。巢狀的資料與數字型別會被保留。"
          }
        }
      }
    },
