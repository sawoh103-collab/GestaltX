    "Allow Always-On Display to reach a higher brightness level.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Always-On Display to reach a higher brightness level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“始终显示”达到更高亮度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que la pantalla siempre activa alcance un mayor nivel de brillo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازه می‌دهد نمایش همیشه‌روشن به روشنایی بالاتری برسد."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상시표시형 디스플레이가 더 높은 밝기에 도달하도록 제한을 해제합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешает Always-On Display достигать более высокой яркости."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Màn hình luôn bật đạt độ sáng cao hơn."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "允許「永遠顯示」達到更高亮度。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "允許「永遠顯示」達到更高亮度。"
          }
        }
      }
    },
