          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به دستگاه در شبیه‌ساز ممکن نیست. برای آزمایش GestaltX یک plist باز کنید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 시뮬레이터에서는 실제 기기 접근이 제한됩니다. GestaltX 인터페이스를 둘러보려면 로컬 plist를 여십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к устройству недоступен в Симуляторе. Откройте plist для знакомства с GestaltX."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể truy cập thiết bị trong Trình mô phỏng. Mở tệp plist để thử GestaltX."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器無法訪問設備文件，你可以打開 plist 體驗 GestaltX。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器無法訪問裝置檔案，你可以開啟 plist 體驗 GestaltX。"
          }
        }
      }
    },
    "The signed app has no usable App Group. Enable its App Group capability and sign it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
