            "state": "translated",
            "value": "Raw system fields. Review the key and type before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里是原始系统字段，保存前请核对键名与类型。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Campos sin procesar del sistema. Revisa la clave y el tipo antes de guardar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فیلدهای خام سیستم. پیش از ذخیره، کلید و نوع آن را بررسی کنید."
          }
        },
        "ko": {
