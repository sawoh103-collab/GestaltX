    "The artwork field is not a dictionary. Edit it in MG Control before using these presets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The artwork field is not a dictionary. Edit it in MG Control before using these presets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "artwork 字段不是字典，请先在 MG 控制中编辑此字段，再使用这些预设。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El campo artwork no es un diccionario. Edítalo en Control de MG antes de usar estos preajustes."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فیلد artwork از نوع دیکشنری نیست. پیش از استفاده از این پیش‌تنظیم‌ها، آن را در MG Control ویرایش کنید."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "artwork 필드가 유효한 딕셔너리 구조가 아닙니다. 이 프리셋 항목들을 사용하기 전에 MG Control 메뉴에서 해당 필드를 먼저 수정하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле artwork не является словарём. Отредактируйте его в MG Control перед использованием этих пресетов."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trường artwork không phải là từ điển. Hãy chỉnh sửa trường này trong MG Control trước khi dùng các thiết lập sẵn này."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "artwork 欄位不是字典，請先在 MG 控制中編輯此欄位，再使用這些預設。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "artwork 欄位不是字典，請先在 MG 控制中編輯此欄位，再使用這些預設。"
          }
        }
      }
    },
    "High-Luminance Always-On Display": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-Luminance Always-On Display"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高亮度始终显示"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalla siempre activa de alta luminancia"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایش همیشه‌روشن با روشنایی بالا"
          }
        },
        "ko": {
