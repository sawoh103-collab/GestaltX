    "System-cache access depends on OS and signing. Upstream lists SystemGroup access for iOS 27; iOS 26 can use local files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System-cache access depends on OS and signing. Upstream lists SystemGroup access for iOS 27; iOS 26 can use local files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统缓存的访问取决于系统版本与签名。上游仅列明 iOS 27 可访问 SystemGroup；iOS 26 可编辑本地文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la caché del sistema depende del SO y de la firma. Upstream indica acceso a SystemGroup para iOS 27; iOS 26 puede usar archivos locales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به حافظهٔ نهان سیستم به سیستم‌عامل و امضا بستگی دارد. پروژهٔ اصلی دسترسی به SystemGroup را برای iOS 27 اعلام کرده است؛ در iOS 26 می‌توان با فایل‌های محلی کار کرد."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 캐시 접근 권한은 OS 버전 및 앱 서명 상태에 따라 다릅니다. 원본 프로젝트에서는 iOS 27의 SystemGroup 접근을 지원하며, iOS 26에서는 로컬 파일을 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к системному кэшу зависит от ОС и подписи. Исходный проект заявляет доступ к SystemGroup для iOS 27; на iOS 26 доступны локальные файлы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập bộ nhớ đệm hệ thống tùy thuộc vào hệ điều hành và chữ ký. Dự án gốc liệt kê quyền truy cập SystemGroup cho iOS 27; iOS 26 có thể dùng tệp cục bộ."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "系統緩存的訪問取決於系統版本與簽名。上游僅列明 iOS 27 可訪問 SystemGroup；iOS 26 可編輯本地文件。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "系統快取的訪問取決於系統版本與簽名。上游僅列明 iOS 27 可訪問 SystemGroup；iOS 26 可編輯本地檔案。"
          }
        }
      }
    },
