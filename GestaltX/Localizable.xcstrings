    "This removes the local backup permanently. It does not change the device file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the local backup permanently. It does not change the device file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地备份将被永久删除，设备文件不会被修改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el respaldo local de forma permanente. No modifica el archivo del dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کار نسخهٔ پشتیبان محلی را برای همیشه حذف می‌کند. فایل دستگاه تغییر نمی‌کند."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 백업 파일이 영구적으로 삭제됩니다. 기기의 시스템 파일은 변경되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная резервная копия будет удалена безвозвратно. Файл на устройстве не изменится."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa vĩnh viễn bản sao lưu cục bộ, không thay đổi tệp trên thiết bị."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本地備份將被永久刪除，設備文件不會被修改。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "本地備份將被永久刪除，裝置檔案不會被修改。"
          }
        }
      }
