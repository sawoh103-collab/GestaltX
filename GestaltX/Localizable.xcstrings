    "Expose internal menus. Some system services may behave differently.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expose internal menus. Some system services may behave differently."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示内部菜单，部分系统服务的行为可能发生变化。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar menús internos. Algunos servicios del sistema podrían comportarse de manera diferente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "منوهای داخلی را نمایش دهید. ممکن است برخی خدمات سیستم رفتار متفاوتی داشته باشند."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple의 내부 기능 관련 메뉴를 표시합니다. 이를 활성화하면 일부 시스템 서비스의 동작이 달라질 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать внутренние меню. Некоторые системные службы могут работать иначе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị menu nội bộ. Một số dịch vụ hệ thống có thể hoạt động khác đi."
          }
        },
        "zh-Hant-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示內部菜單，部分系統服務的行為可能發生變化。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示內部選單，部分系統服務的行為可能發生變化。"
          }
        }
      }
    },
